<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgIconoTransporte"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_caja_blanca" android:padding="10dp"
            tools:src="@drawable/ic_barco"
            app:tint="#90A93E"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvOrdenId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            tools:text="ORD2355-234"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/imgIconoTransporte"
            app:layout_constraintTop_toTopOf="@id/imgIconoTransporte" />

        <TextView
            android:id="@+id/tvRuta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Barcelona → Managua"
            android:textColor="#7A7A7A"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tvOrdenId"
            app:layout_constraintTop_toBottomOf="@id/tvOrdenId" />

        <TextView
            android:id="@+id/tvEstadoFinal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_etiqueta_verde"
            android:backgroundTint="#155196"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Entregado"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvOrdenId"
            app:layout_constraintBottom_toBottomOf="@id/tvOrdenId"/>

        <View
            android:id="@+id/linea"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E4E8ED"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/imgIconoTransporte"/>

        <TextView
            android:id="@+id/tvProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Alimentos - Cafe de calidad"
            android:textColor="#555555"
            android:textSize="12sp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linea"
            app:layout_constraintEnd_toStartOf="@id/tvPeso" />

        <TextView
            android:id="@+id/tvPeso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="860 Kg"
            android:textColor="#7A7A7A"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_caja"
            android:drawablePadding="6dp"
            app:drawableTint="#7A7A7A"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvProducto"/>

        <LinearLayout
            android:id="@+id/layoutFechas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvProducto">

            <TextView
                android:id="@+id/tvFechaSalida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Fecha de salida: 12-05-2025"
                android:textColor="#A0A0A0"
                android:textSize="10sp"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tvFechaEntrega"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Entregado: 12-05-2026"
                android:textColor="#A0A0A0"
                android:textSize="10sp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDescargarFactura"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="16dp"
            android:text="Descargar factura"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:icon="@drawable/ic_bajar" app:iconGravity="textStart"
            app:backgroundTint="#7A98BC" app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/layoutFechas"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>