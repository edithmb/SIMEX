<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historial de envíos"
                android:textColor="#1A1A1A"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <EditText
                android:id="@+id/inputBuscadorHistorial"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_caja_texto"
                android:hint="Buscar orden o destino..."
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:drawableTint="#90A93E"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filtrar por:"
                    android:textColor="#1A1A1A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFiltroTodos"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Todos"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            app:backgroundTint="#3B5F8F"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFiltroMaritimo"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Marítimo"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            app:backgroundTint="#90A93E"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFiltroAereo"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Aéreo"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            app:backgroundTint="#90A93E"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFiltroTerrestre"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Terrestre"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            app:backgroundTint="#90A93E"
                            app:cornerRadius="8dp"/>
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_history"
                tools:itemCount="3" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottom_navigation"
        layout="@layout/layout_menu_reutilizable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>