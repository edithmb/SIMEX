<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB">

    <TextView
        android:id="@+id/tituloPerfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:text="Perfil"
        android:textColor="#8AB242"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgPerfil"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="#C8D3E0"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/EstiloCirculo"
        app:layout_constraintTop_toBottomOf="@id/tituloPerfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <ImageView
        android:id="@+id/iconoEditarFoto"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_white_circle"
        android:backgroundTint="#8AB242"
        android:src="@drawable/ic_lapiz"
        android:padding="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/imgPerfil"
        app:layout_constraintEnd_toEndOf="@id/imgPerfil" />

    <TextView
        android:id="@+id/nombreEmpresa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        tools:text="Peluche Corporations"
        app:layout_constraintTop_toBottomOf="@id/imgPerfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnEditarPerfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:layout_marginTop="16dp"
        android:text="Editar perfil"
        app:backgroundTint="#5C82B1"
        app:cornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@id/nombreEmpresa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnEditarPerfil"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Datos personales"
                android:textColor="#8AB242"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView style="@style/EstiloEtiquetaFormulario" android:text="Nombre completo" />
            <EditText android:id="@+id/inputName" style="@style/EstiloInputFormulario" android:enabled="false" android:hint="Federico Maradonio" android:inputType="textPersonName" />

            <TextView style="@style/EstiloEtiquetaFormulario" android:text="Correo electronico" />
            <EditText android:id="@+id/inputEmail" style="@style/EstiloInputFormulario" android:enabled="false" android:hint="Fpeluche@corporation.com" android:inputType="textEmailAddress" />

            <TextView style="@style/EstiloEtiquetaFormulario" android:text="Telefono móvil" />
            <EditText android:id="@+id/inputTelephoneNumber" style="@style/EstiloInputFormulario" android:enabled="false" android:hint="000000000" android:inputType="phone" />



            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="Documento de Identidad"
                android:textColor="#8AB242"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_descargar_dni"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ver / Descargar DNI actual"
                android:textColor="#5C82B1"
                app:iconTint="#5C82B1"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="32dp"
                android:gravity="center"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/subir_arxivos"
                    app:tint="#8AB242"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Actualizar imagen del DNI"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JPG, PNG o PDF — máx. 5MB"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_seleccionar_archivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:backgroundTint="#5C82B1"
                    android:text="Subir archivo"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_guardar_cambios"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                app:backgroundTint="#8AB242"
                android:text="Guardar Cambios"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottom_navigation"
        layout="@layout/layout_menu_reutilizable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>